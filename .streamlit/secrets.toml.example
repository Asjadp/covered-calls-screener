# Example secrets configuration for Cloud Database persistence
# Rename this file or copy its contents into your Streamlit Cloud Settings > Secrets
# If left blank, the app will automatically default to local SQLite storage.

# Option 1: Free Supabase PostgreSQL Database URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
# DATABASE_URL = "postgresql://postgres.xxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Option 2: Free Neon PostgreSQL Database URL
# DATABASE_URL = "postgresql://user:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
